[Unit]
Description=PortHub restricted network helper
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=porthub
ExecStart=/opt/porthub/bin/porthub-netd -socket /run/porthub/netd.sock -allowed-dir /var/lib/porthub/core/netd -allowed-table porthub_core -relay-config /var/lib/porthub/relay/config.json -relay-service porthub-relay -managed-services qx-lan-socks,qx-lan-config-http,dst-wireguard,dst-wireguard-health,dst-wireguard-register,prefer-real-ipv6-gateway
Restart=always
RestartSec=3
TimeoutStartSec=10
RuntimeDirectory=porthub
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_CHOWN
ReadWritePaths=/run/porthub /var/lib/porthub/relay
ReadOnlyPaths=/var/lib/porthub/core/netd

[Install]
WantedBy=multi-user.target
