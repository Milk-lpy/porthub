[Unit]
Description=PortHub cross-family port relay
After=network-online.target porthub-netd.service
Wants=network-online.target
ConditionPathExists=/var/lib/porthub/relay/config.json

[Service]
Type=simple
User=porthub-relay
Group=porthub-relay
ExecStart=/opt/porthub/bin/porthub-relay -config /var/lib/porthub/relay/config.json -status /var/lib/porthub/relay/status.json -poll 5
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/porthub/relay
UMask=0027

[Install]
WantedBy=multi-user.target
